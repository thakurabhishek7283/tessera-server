# Copy to .env and adjust. Every variable is optional; the values shown are the defaults.

# --- server ---
PORT=8787
HOST=0.0.0.0
# Public base URL, used to build upload links returned to clients.
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=./data/tessera.db
# Comma-separated browser origins allowed to call the API. '*' is only accepted when AUTH_MODE=dev.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Interactive API docs at /docs (true | false).
ENABLE_DOCS=true
# REST requests per client IP per minute (/health is exempt).
RATE_LIMIT_PER_MINUTE=300

# --- authentication: dev | secret | jwks ---
# dev    guests allowed; POST /v1/auth/guest issues tokens (never use in production)
# secret your backend signs HS256 JWTs with JWT_SECRET (min. 32 characters)
# jwks   tokens from an identity provider, verified against JWKS_URL (RS256/ES256)
AUTH_MODE=dev
JWT_SECRET=change-me
JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# Names of the claims to read user fields from.
JWT_CLAIM_USER_ID=sub
JWT_CLAIM_NAME=name
JWT_CLAIM_AVATAR=picture
JWT_CLAIM_ROLES=roles
# Optional claim listing the app ids a token may use; absent claim means any app.
JWT_CLAIM_APPS=tessera_apps

# --- uploads ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED=image/png,image/jpeg,image/webp,image/gif,application/pdf

# --- calls ---
CALL_MAX_PARTICIPANTS=6
STUN_URLS=stun:stun.l.google.com:19302
# TURN (optional): coturn with use-auth-secret. See docker-compose.yml, profile "turn".
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
